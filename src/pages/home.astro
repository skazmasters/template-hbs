---
import Default from '../layouts/Default.astro'
---

<Default title="Home" current="home">
  <main class="relative flex min-h-[calc(100svh-8rem)] flex-col justify-end overflow-hidden px-[4vw] pb-16 pt-28">
    <p class="absolute top-10 right-[4vw] font-mono text-[11px] tracking-[0.18em] text-muted uppercase">
      01 · Home
    </p>
    <div class="absolute top-[18%] bottom-[22%] left-[4vw] hidden w-px bg-accent lg:block" aria-hidden="true"></div>
    <h1 class="max-w-[13ch] font-serif text-[clamp(4.75rem,13vw,9.5rem)] leading-[0.8] tracking-tight">
      Replace<br />this page.
    </h1>
    <p class="mt-10 max-w-md text-lg leading-relaxed text-muted">
      Keep the route. Swap the markup. This plate is the homepage frame for the layout.
    </p>
  </main>
</Default>
