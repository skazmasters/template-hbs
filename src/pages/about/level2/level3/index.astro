---
import Default from '../../../../layouts/Default.astro'
---

<Default title="About Level 3" current="about-level3">
  <main class="px-[4vw] py-16 lg:py-24">
    <p class="mb-16 font-mono text-[11px] tracking-[0.18em] text-muted uppercase">04 · Type specimen</p>
    <div class="grid gap-12 lg:grid-cols-3">
      <div>
        <p class="font-mono text-[11px] text-accent uppercase">Serif</p>
        <p class="mt-3 font-serif text-5xl leading-none">Instrument</p>
      </div>
      <div>
        <p class="font-mono text-[11px] text-accent uppercase">Sans</p>
        <p class="mt-3 text-5xl leading-none tracking-tight">Instrument</p>
      </div>
      <div>
        <p class="font-mono text-[11px] text-accent uppercase">Mono</p>
        <p class="mt-3 font-mono text-3xl leading-none">IBM Plex</p>
      </div>
    </div>
    <p class="mt-20 max-w-xl text-lg leading-relaxed text-muted">
      Deepest example route. Use it as a type sheet, a legal page, or delete the folder.
    </p>
  </main>
</Default>
