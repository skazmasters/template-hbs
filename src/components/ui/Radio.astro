---
interface Props {
  name?: string
  value?: string
  label?: string
  checked?: boolean
}

const { name, value, label, checked = false } = Astro.props
---

<label class="inline-flex cursor-pointer items-center gap-2 text-sm">
  <input class="size-4 accent-accent" type="radio" checked={checked} name={name} value={value} />
  <span>{label}</span>
</label>
