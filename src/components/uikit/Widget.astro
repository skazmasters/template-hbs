---
interface Props {
  title: string
  width?: number
  background?: boolean
}

const { title, width, background = false } = Astro.props
---

<figure class:list={['flex min-w-[12rem] flex-1 flex-col border border-rule', background && 'bg-ink/5']}>
  <figcaption class="border-b border-rule px-3 py-1 font-mono text-[10px] tracking-[0.12em] text-muted uppercase">
    {title}
  </figcaption>
  <div class="flex flex-1 items-center justify-center p-6">
    <div class="w-full" style={width ? `max-width:${width}px` : undefined}>
      <slot />
    </div>
  </div>
</figure>
